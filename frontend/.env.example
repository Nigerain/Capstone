# Copy to .env. Keep actual .env files out of Git.
# Use the PC Wi-Fi IP for physical phones. Restart Expo after changing values.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8001

# Public Firebase web configuration for real authentication.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=grocerypricepal.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=grocerypricepal
EXPO_PUBLIC_FIREBASE_APP_ID=

# All app data, submissions, votes and scans use real services.
# Private service-account credentials belong only in backend/.env.
