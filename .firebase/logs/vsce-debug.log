ndestination AS (\n  INSERT INTO price_record (\n    id, item_id, store_id, price,\n    date_recorded, is_public, pool_scope\n  )\n  SELECT\n    gen_random_uuid(),\n    e.item_id,\n    e.store_id,\n    e.price,\n    CURRENT_DATE,\n    e.is_public,\n    e.pool_scope\n  FROM eligible e\n  WHERE TRUE\n  ON CONFLICT (item_id, store_id, price, pool_scope)\n  DO UPDATE SET price = EXCLUDED.price\n  RETURNING id\n)\n\nINSERT INTO price_submission (\n  price_record_id, user_id, created_at, ended_at\n)\nSELECT d.id, e.user_id, statement_timestamp(), NULL\nFROM destination d\nCROSS JOIN eligible e\nWHERE NOT EXISTS (\n  SELECT 1 FROM price_vote pv\n  WHERE pv.price_record_id = d.id\n    AND pv.user_id = e.user_id\n)\nAND NOT EXISTS (\n  SELECT 1 FROM price_submission ps\n  WHERE ps.price_record_id = d.id\n    AND ps.user_id = e.user_id\n    AND ps.ended_at IS NULL\n)\nParams: [test-a 16151e4b-31ac-4539-89b8-7c9638794be7 ea0286ea-69e1-450d-96d7-12b09e7e4fc1 2.99 true true 2.99 16151e4b-31ac-4539-89b8-7c9638794be7 ea0286ea-69e1-450d-96d7-12b09e7e4fc1 2.99 true 16151e4b-31ac-4539-89b8-7c9638794be7 ea0286ea-69e1-450d-96d7-12b09e7e4fc1 2.99 true]","resource":"","warningLevel":"WARNING_LEVEL_UNKNOWN","workarounds":[]}}],"extensions":null}
