W()\n      WHERE EXISTS (\n        SELECT 1\n        FROM price_record\n        WHERE id = $1\n          AND user_id <> $2\n          AND is_public = TRUE\n      )\n      ON CONFLICT (price_record_id, user_id)\n      DO UPDATE SET is_upvote = EXCLUDED.is_upvote\n    \"\"\"\n    params: [$priceRecordId, $userId, $isUpvote]\n  )\n}\n\n# let users remove their own vote from a submitted price.\n# the backend verifies that the vote belongs to the user.\nmutation RemovePriceVote(\n  $priceRecordId: UUID!\n  $userId: String!\n) @auth(level: NO_ACCESS) {\n  _execute(\n    sql: \"\"\"\n      DELETE FROM price_vote\n      WHERE price_record_id = $1\n        AND user_id = $2\n    \"\"\"\n    params: [$priceRecordId, $userId]\n  )\n}\n# help you search for items. Doesn't care about upper or lower case. \nquery SearchItems($pattern: String!) @auth(level: NO_ACCESS) {\n  items(\n    where: {\n      itemName: {\n        pattern: {\n          like: $pattern\n          ignoreCase: true\n        }\n      }\n    }\n    orderBy: { itemName: ASC }\n    limit: 20\n  )\n\n  {\n    id\n    itemName\n    brand\n    unitSize\n  }\n}\n\n# Grab the price of the item if it's public\nquery GetItemPrices($itemId: UUID!) @auth(level: NO_ACCESS) {\n  priceRecords(\n    where: {\n      itemId: { eq: $itemId }\n      isPublic: { eq: true }\n    }\n    orderBy: { dateRecorded: DESC }\n    limit: 50\n  )\n\n  {\n    id\n    price\n    dateRecorded\n    isPublic\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n\n    user {\n      id\n    }\n  }\n}\n\n# Let you search for stores when you're trying to submit a  price.\nquery SearchStores($pattern: String!) @auth(level: NO_ACCESS) {\n  stores(\n    where: {\n      storeName: {\n        pattern: {\n          like: $pattern\n          ignoreCase: true\n        }\n      }\n    }\n    orderBy: { storeName: ASC }\n    limit: 20\n  )\n  \n  {\n    id\n    storeName\