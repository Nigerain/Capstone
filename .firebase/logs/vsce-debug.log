ation needed to calculate its final confidence.\nquery GetPriceConfidenceData($priceRecordId: UUID!) @auth(level: NO_ACCESS) {\n  priceRecord(\n    id: $priceRecordId\n  )\n\n  {\n    id\n    price\n    dateRecorded\n    isPublic\n\n    user {\n      id\n      createdAt\n    }\n\n    item {\n      id\n      itemName\n    }\n\n    store {\n      id\n      storeName\n    }\n  }\n}\n\n# grab the price history of an item at a specific store.\n# only show prices that are public.\nquery GetPriceHistory(\n  $itemId: UUID!\n  $storeId: UUID!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: NO_ACCESS) {\n  priceRecords(\n    where: {\n      itemId: { eq: $itemId }\n      storeId: { eq: $storeId }\n      isPublic: { eq: true }\n    }\n    orderBy: [\n      { dateRecorded: DESC }\n      { id: DESC }\n    ]\n    limit: $limit\n    offset: $offset\n  )\n\n  {\n    id\n    price\n    dateRecorded\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n  }\n}\n\n# grab all the prices submitted by a user.\n# let them see their previous submissions including private ones.\nquery GetUserSubmissions(\n  $userId: String!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: NO_ACCESS) {\n  priceRecords(\n    where: {\n      userId: { eq: $userId }\n    }\n    orderBy: [\n      { dateRecorded: DESC }\n      { id: DESC }\n    ]\n    limit: $limit\n    offset: $offset\n  )\n\n  {\n    id\n    price\n    dateRecorded\n    isPublic\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n  }\n}\n\n",
