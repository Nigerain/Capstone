[debug] [2026-10-09T21:45:18.058Z] >>> [apiv2][body] POST http://127.0.0.1:9399/v1/projects/grocerypricepal/locations/us-east4/services/grocerypricepal-service:executeGraphql {"operationName":"GetItemPrices","variables":{"pattern":"%milk%"},"query":"\n# create their account after they sign up using Firebase Authentication.\n# the backend verifies their identity before creating their profile.\nmutation CreateUserProfile(\n  $userId: String!\n  $username: String!\n  $firstName: String!\n  $lastName: String!\n  $email: String!\n) @auth(level: NO_ACCESS) {\n  user_insert(\n    data: {\n      id: $userId\n      username: $username\n      firstName: $firstName\n      lastName: $lastName\n      email: $email\n    }\n  )\n}\n\n# let users submit a price manually or using OCR.\n# the backend verifies the user before saving their price.\nmutation CreatePrice(\n  $itemId: UUID!\n  $storeId: UUID!\n  $userId: String!\n  $price: Float!\n  $isPublic: Boolean!\n) @auth(level: NO_ACCESS) {\n  priceRecord_insert(\n    data: {\n      itemId: $itemId\n      storeId: $storeId\n      userId: $userId\n      price: $price\n      isPublic: $isPublic\n    }\n  )\n}\n\n# verify they're logged in and authenticated before letting them make items.\nmutation CreateItem(\n  $itemName: String!\n  $brand: String\n  $unitSize: String\n) @auth(level: NO_ACCESS) {\n  item_insert(\n    data: {\n      itemName: $itemName\n      brand: $brand\n      unitSize: $unitSize\n    }\n  )\n}\n\n# verify they're logged in and authenticated before letting them make stores.\nmutation CreateStore(\n  $storeName: String!\n  $storeLocation: String\n) @auth(level: NO_ACCESS) {\n  store_insert(\n    data: {\n      storeName: $storeName\n      storeLocation: $storeLocation\n    }\n  )\n}\n\n# let users upvote or downvote a submitted price.\n# if they already voted, update their existing vote.\n# the backend verifies the user and prevents self-voting.\nmutation SubmitPriceVote(\n  $priceRecordId: UUID!\n  $userId: String!\n  $isUpvote: Boolean!\n) @auth(level: NO_ACCESS) {\n  _execute(\n    sql: \"\"\"\n      INSERT INTO price_vote (\n        price_record_id,\n        user_id,\n        is_upvote,\n        created_at\n      )\n      SELECT $1, $2, $3, NOW()\n      WHERE EXISTS (\n        SELECT 1\n        FROM price_record\n        WHERE id = $1\n          AND user_id <> $2\n          AND is_public = TRUE\n      )\n      ON CONFLICT (price_record_id, user_id)\n      DO UPDATE SET is_upvote = EXCLUDED.is_upvote\n    \"\"\"\n    params: [$priceRecordId, $userId, $isUpvote]\n  )\n}\n\n# let users remove their own vote from a submitted price.\n# the backend verifies that the vote belongs to the user.\nmutation RemovePriceVote(\n  $priceRecordId: UUID!\n  $userId: String!\n) @auth(level: NO_ACCESS) {\n  _execute(\n    sql: \"\"\"\n      DELETE FROM price_vote\n      WHERE price_record_id = $1\n        AND user_id = $2\n    \"\"\"\n    params: [$priceRecordId, $userId]\n  )\n}\n# help you search for items. Doesn't care about upper or lower case. \nquery SearchItems($pattern: String!) @auth(level: NO_ACCESS) {\n  items(\n    where: {\n      itemName: {\n        pattern: {\n          like: $pattern\n          ignoreCase: true\n        }\n      }\n    }\n    orderBy: { itemName: ASC }\n    limit: 20\n  )\n\n  {\n    id\n    itemName\n    brand\n    unitSize\n  }\n}\n\n# Grab the price of the item if it's public\nquery GetItemPrices($itemId: UUID!) @auth(level: NO_ACCESS) {\n  priceRecords(\n    where: {\n      itemId: { eq: $itemId }\n      isPublic: { eq: true }\n    }\n    orderBy: { dateRecorded: DESC }\n    limit: 50\n  )\n\n  {\n    id\n    price\n    dateRecorded\n    isPublic\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n\n    user {\n      id\n    }\n  }\n}\n\n# Let you search for stores when you're trying to submit a  price.\nquery SearchStores($pattern: String!) @auth(level: NO_ACCESS) {\n  stores(\n    where: {\n      storeName: {\n        pattern: {\n          like: $pattern\n          ignoreCase: true\n        }\n      }\n    }\n    orderBy: { storeName: ASC }\n    limit: 20\n  )\n  \n  {\n    id\n    storeName\n    storeLocation\n  }\n}\n\n# grab the user's account age and number of price submissions for voter reputation.\nquery GetUserStats($userId: String!) @auth(level: NO_ACCESS) {\n  user(\n    key: { id: $userId }\n  )\n\n  {\n    id\n    createdAt\n  }\n\n  totalSubmissions: priceRecords(\n    where: {\n      userId: { eq: $userId }\n    }\n  )\n\n  {\n    _count\n  }\n}\n\n# grab the user's previous submissions and their unweighted votes for submitter reputation.\n# use limit and offset to grab more history.\nquery GetSubmitterVoteHistory(\n  $userId: String!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: NO_ACCESS) {\n  priceHistory: _select(\n    sql: \"\"\"\n      SELECT\n        pr.id AS \"priceRecordId\",\n        pr.date_recorded AS \"dateRecorded\",\n        COUNT(*) FILTER (WHERE pv.is_upvote = TRUE) AS \"upvotes\",\n        COUNT(*) FILTER (WHERE pv.is_upvote = FALSE) AS \"downvotes\"\n      FROM price_record pr\n      LEFT JOIN price_vote pv\n        ON pv.price_record_id = pr.id\n      WHERE pr.user_id = $1\n      GROUP BY pr.id, pr.date_recorded\n      ORDER BY pr.date_recorded DESC, pr.id DESC\n      LIMIT $2 OFFSET $3\n    \"\"\"\n    params: [$userId, $limit, $offset]\n  )\n}\n\n# grab all the votes for a price to calculate the weighted consensus.\n# also grab the voter's account age and when they voted.\nquery GetPriceVotes(\n  $priceRecordId: UUID!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: NO_ACCESS) {\n  votes: _select(\n    sql: \"\"\"\n      SELECT\n        pv.price_record_id AS \"priceRecordId\",\n        pv.user_id AS \"userId\",\n        pv.is_upvote AS \"isUpvote\",\n        pv.created_at AS \"createdAt\",\n        u.created_at AS \"accountCreatedAt\"\n      FROM price_vote pv\n      JOIN \"user\" u\n        ON u.id = pv.user_id\n      WHERE pv.price_record_id = $1\n      ORDER BY pv.created_at DESC, pv.user_id ASC\n      LIMIT $2 OFFSET $3\n    \"\"\"\n    params: [$priceRecordId, $limit, $offset]\n  )\n}\n\n# grab the price information needed to calculate its final confidence.\nquery GetPriceConfidenceData($priceRecordId: UUID!) @auth(level: NO_ACCESS) {\n  priceRecord(\n    id: $priceRecordId\n  )\n\n  {\n    id\n    price\n    dateRecorded\n    isPublic\n\n    user {\n      id\n      createdAt\n    }\n\n    item {\n      id\n      itemName\n    }\n\n    store {\n      id\n      storeName\n    }\n  }\n}\n\n# grab the price history of an item at a specific store.\n# only show prices that are public.\nquery GetPriceHistory(\n  $itemId: UUID!\n  $storeId: UUID!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: NO_ACCESS) {\n  priceRecords(\n    where: {\n      itemId: { eq: $itemId }\n      storeId: { eq: $storeId }\n      isPublic: { eq: true }\n    }\n    orderBy: [\n      { dateRecorded: DESC }\n      { id: DESC }\n    ]\n    limit: $limit\n    offset: $offset\n  )\n\n  {\n    id\n    price\n    dateRecorded\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n  }\n}\n\n# grab all the prices submitted by a user.\n# let them see their previous submissions including private ones.\nquery GetUserSubmissions(\n  $userId: String!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: NO_ACCESS) {\n  priceRecords(\n    where: {\n      userId: { eq: $userId }\n    }\n    orderBy: [\n      { dateRecorded: DESC }\n      { id: DESC }\n    ]\n    limit: $limit\n    offset: $offset\n  )\n\n  {\n    id\n    price\n    dateRecorded\n    isPublic\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n  }\n}\n\n","extensions":{}}
