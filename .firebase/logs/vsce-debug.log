[debug] [2026-10-10T04:18:18.404Z] >>> [apiv2][query] POST http://127.0.0.1:9399/v1/projects/grocerypricepal/locations/us-east4/services/grocerypricepal-service:executeGraphql [none]
[debug] [2026-10-10T04:18:18.405Z] >>> [apiv2][body] POST http://127.0.0.1:9399/v1/projects/grocerypricepal/locations/us-east4/services/grocerypricepal-service:executeGraphql {"operationName":"CreateUserProfile","variables":{"username":"test_a","firstName":"Test","lastName":"User"},"query":"# create their account after they sign up using Firebase Authentication.\n# uses firebase for authenticated ID and email.\nmutation CreateUserProfile(\n  $username: String!\n  $firstName: String!\n  $lastName: String!\n) @auth(level: USER) {\n  user_insert(\n    data: {\n      id_expr: \"auth.uid\"\n      username: $username\n      firstName: $firstName\n      lastName: $lastName\n      email_expr: \"auth.token.email\"\n    }\n  )\n}\n\n# let users submit a price manually or using OCR.\n# create a price pool or join the matching one.\nmutation CreatePrice(\n  $itemId: UUID!\n  $storeId: UUID!\n  $price: Float!\n  $isPublic: Boolean!\n) @auth(level: USER) @transaction {\n  ...LockAccount\n\n  savedSubmission: _execute(\n    sql: \"\"\"\n      WITH destination AS (\n        INSERT INTO price_record (\n          id, item_id, store_id, price,\n          date_recorded, is_public, pool_scope\n        )\n        SELECT\n          gen_random_uuid(), $1::uuid, $2::uuid,\n          ROUND($3::numeric, 2)::double precision,\n          CURRENT_DATE, $4::boolean,\n          CASE\n            WHEN $4::boolean THEN 'public'\n            ELSE 'private:' || $5::text\n          END\n        WHERE $3::numeric BETWEEN 0.01 AND 99999.99\n        ON CONFLICT (item_id, store_id, price, pool_scope)\n        DO UPDATE SET price = EXCLUDED.price\n        RETURNING id\n      )\n      INSERT INTO price_submission (\n        price_record_id, user_id, created_at, ended_at\n      )\n      SELECT d.id, $5, statement_timestamp(), NULL\n      FROM destination d\n      WHERE NOT EXISTS (\n        SELECT 1 FROM price_vote pv\n        WHERE pv.price_record_id = d.id\n          AND pv.user_id = $5\n      )\n      AND NOT EXISTS (\n        SELECT 1 FROM price_submission ps\n        WHERE ps.price_record_id = d.id\n          AND ps.user_id = $5\n          AND ps.ended_at IS NULL\n      )\n    \"\"\"\n    params: [\n      $itemId\n      $storeId\n      $price\n      $isPublic\n      {_expr: \"auth.uid\"}\n    ]\n  ) @check(\n    expr: \"this == 1\"\n    message: \"Invalid price, already supporting this pool, or already voted on it.\"\n  )\n}\n# let users update their own submitted price.\n# move their submission to an existing price pool or create a new one.\n# don't change the price for other users in the original pool.\n# move only the logged-in user's submission.\n# keep the old pool and its votes for everyone else.\nmutation UpdatePrice(\n  $priceRecordId: UUID!\n  $price: Float!\n) @auth(level: USER) @transaction {\n  ...LockAccount\n\n  updatedSubmission: _execute(\n    sql: \"\"\"\n      /* find the user's active submission */\n      WITH original AS (\n        SELECT\n          ps.created_at,\n          pr.item_id,\n          pr.store_id,\n          pr.is_public,\n          pr.pool_scope\n        FROM price_submission ps\n        JOIN price_record pr ON pr.id = ps.price_record_id\n        WHERE ps.price_record_id = $1\n          AND ps.user_id = $2\n          AND ps.ended_at IS NULL\n          AND $3::numeric BETWEEN 0.01 AND 99999.99\n          AND pr.price <> ROUND($3::numeric, 2)::double precision\n        FOR UPDATE OF ps\n      ),\n\n      /* the unique constraint prevents duplicate pools */\n      destination AS (\n        INSERT INTO price_record (\n          id, item_id, store_id, price,\n          date_recorded, is_public, pool_scope\n        )\n        SELECT\n          gen_random_uuid(), o.item_id, o.store_id,\n          ROUND($3::numeric, 2)::double precision,\n          CURRENT_DATE, o.is_public, o.pool_scope\n        FROM original o\n        WHERE TRUE\n        ON CONFLICT (item_id, store_id, price, pool_scope)\n        DO UPDATE SET price = EXCLUDED.price\n        RETURNING id\n      ),\n\n      /* start a new participation period */\n      joined AS (\n        INSERT INTO price_submission (\n          price_record_id, user_id, created_at, ended_at\n        )\n        SELECT d.id, $2, statement_timestamp(), NULL\n        FROM destination d\n        WHERE NOT EXISTS (\n          SELECT 1 FROM price_vote pv\n          WHERE pv.price_record_id = d.id\n            AND pv.user_id = $2\n        )\n        AND NOT EXISTS (\n          SELECT 1 FROM price_submission ps\n          WHERE ps.price_record_id = d.id\n            AND ps.user_id = $2\n            AND ps.ended_at IS NULL\n        )\n        RETURNING price_record_id\n      )\n\n      /* close the old period only when the destination is supported */\n      UPDATE price_submission ps\n      SET ended_at = statement_timestamp()\n      FROM original o\n      WHERE ps.price_record_id = $1\n        AND ps.user_id = $2\n        AND ps.created_at = o.created_at\n        AND (\n          EXISTS (SELECT 1 FROM joined)\n          OR EXISTS (\n            SELECT 1\n            FROM destination d\n            JOIN price_submission existing\n              ON existing.price_record_id = d.id\n            WHERE existing.user_id = $2\n              AND existing.ended_at IS NULL\n          )\n        )\n    \"\"\"\n    params: [\n      $priceRecordId\n      {_expr: \"auth.uid\"}\n      $price\n    ]\n  ) @check(\n    expr: \"this == 1\"\n    message: \"Cannot move this submission. Check ownership, price, and destination vote.\"\n  )\n}\n\n\n# verify they're logged in and authenticated before letting them make items.\nmutation CreateItem(\n  $itemName: String!\n  $brand: String\n  $unitSize: String\n) @auth(level: USER) {\n  item_insert(\n    data: {\n      itemName: $itemName\n      brand: $brand\n      unitSize: $unitSize\n    }\n  )\n}\n\n# verify they're logged in and authenticated before letting them make stores.\nmutation CreateStore(\n  $storeName: String!\n  $storeLocation: String\n) @auth(level: USER) {\n  store_insert(\n    data: {\n      storeName: $storeName\n      storeLocation: $storeLocation\n    }\n  )\n}\n\n# let users upvote or downvote a submitted price.\n# if they already voted, update their existing vote.\n# prevent users from voting on their own prices.\nmutation SubmitPriceVote(\n  $priceRecordId: UUID!\n  $isUpvote: Boolean!\n) @auth(level: USER) @transaction {\n  ...LockAccount\n\n  savedVote: _execute(\n    sql: \"\"\"\n      /* save the vote under the logged-in user's ID */\n      INSERT INTO price_vote (\n        price_record_id,\n        user_id,\n        is_upvote,\n        created_at\n      )\n      SELECT $1, $2, $3, statement_timestamp()\n\n      /* only allow voting on public prices with active submitters */\n      WHERE EXISTS (\n        SELECT 1\n        FROM price_record pr\n        WHERE pr.id = $1\n          AND pr.is_public = TRUE\n          AND EXISTS (\n            SELECT 1\n            FROM price_submission ps\n            WHERE ps.price_record_id = pr.id\n              AND ps.ended_at IS NULL\n          )\n      )\n\n      /* prevent users from voting on a price they submitted */\n      AND NOT EXISTS (\n        SELECT 1\n        FROM price_submission ps\n        WHERE ps.price_record_id = $1\n          AND ps.user_id = $2\n      )\n\n      /* change an existing vote instead of creating another */\n      ON CONFLICT (price_record_id, user_id)\n      DO UPDATE SET is_upvote = EXCLUDED.is_upvote\n    \"\"\"\n    params: [\n      $priceRecordId\n      {_expr: \"auth.uid\"}\n      $isUpvote\n    ]\n  )\n}\n\n# let logged-in users join an existing shared price.\n# prevent duplicate submissions and joining a price they voted on.\nmutation JoinPrice(\n  $priceRecordId: UUID!\n) @auth(level: USER) @transaction {\n  ...LockAccount\n\n  joinedPrice: _execute(\n    sql: \"\"\"\n      /* link the logged-in user to an existing public price */\n      INSERT INTO price_submission (\n        price_record_id,\n        user_id,\n        created_at,\n        ended_at\n      )\n      SELECT $1, $2, statement_timestamp(), NULL\n\n      /* only join public prices with active submitters */\n      WHERE EXISTS (\n        SELECT 1\n        FROM price_record pr\n        WHERE pr.id = $1\n          AND pr.is_public = TRUE\n          AND EXISTS (\n            SELECT 1\n            FROM price_submission ps\n            WHERE ps.price_record_id = pr.id\n              AND ps.ended_at IS NULL\n          )\n      )\n\n      /* don't let users join a price they already voted on */\n      AND NOT EXISTS (\n        SELECT 1\n        FROM price_vote pv\n        WHERE pv.price_record_id = $1\n          AND pv.user_id = $2\n      )\n\n      /* allow rejoining, but not duplicate active submissions */\n      AND NOT EXISTS (\n        SELECT 1\n        FROM price_submission ps\n        WHERE ps.price_record_id = $1\n          AND ps.user_id = $2\n          AND ps.ended_at IS NULL\n      )\n    \"\"\"\n    params: [\n      $priceRecordId\n      {_expr: \"auth.uid\"}\n    ]\n  )\n}\n\n\n# let users remove their own vote from a submitted price.\n# Firebase uses their authenticated ID to find the vote.\nmutation RemovePriceVote(\n  $priceRecordId: UUID!\n) @auth(level: USER) {\n  _execute(\n    sql: \"\"\"\n      DELETE FROM price_vote\n      WHERE price_record_id = $1\n        AND user_id = $2\n    \"\"\"\n    params: [\n      $priceRecordId\n      {_expr: \"auth.uid\"}\n    ]\n  )\n}\n\nfragment LockAccount on Mutation {\n  accountLock: user_updateMany(\n    where: {\n      id: { eq_expr: \"auth.uid\" }\n    }\n    data: {\n      id_expr: \"auth.uid\"\n    }\n  )\n  @check(\n    expr: \"this == 1\"\n    message: \"Create your user profile first.\"\n  )\n  @redact\n}\n# help you search for items. Doesn't care about upper or lower case. \nquery SearchItems($pattern: String!) @auth(level: USER) {\n  items(\n    where: {\n      itemName: {\n        pattern: {\n          like: $pattern\n          ignoreCase: true\n        }\n      }\n    }\n    orderBy: { itemName: ASC }\n    limit: 20\n  )\n\n  {\n    id\n    itemName\n    brand\n    unitSize\n  }\n}\n\n# Grab the price of the item if it's public\nquery GetItemPrices($itemId: UUID!) @auth(level: USER) {\n  priceRecords: _select(\n    sql: \"\"\"\n      SELECT\n        pr.id,\n        pr.price,\n        pr.date_recorded AS \"dateRecorded\",\n        pr.is_public AS \"isPublic\",\n        jsonb_build_object(\n          'id', i.id,\n          'itemName', i.item_name,\n          'brand', i.brand,\n          'unitSize', i.unit_size\n        ) AS \"item\",\n        jsonb_build_object(\n          'id', s.id,\n          'storeName', s.store_name,\n          'storeLocation', s.store_location\n        ) AS \"store\"\n      FROM price_record pr\n      JOIN item i ON i.id = pr.item_id\n      JOIN store s ON s.id = pr.store_id\n      WHERE pr.item_id = $1::uuid\n        AND pr.is_public = TRUE\n        AND EXISTS (\n          SELECT 1\n          FROM price_submission ps\n          WHERE ps.price_record_id = pr.id\n            AND ps.ended_at IS NULL\n        )\n      ORDER BY pr.date_recorded DESC, pr.id DESC\n      LIMIT 50\n    \"\"\"\n    params: [$itemId]\n  )\n}\n\n# Let you search for stores when you're trying to submit a  price.\nquery SearchStores($pattern: String!) @auth(level: USER) {\n  stores(\n    where: {\n      storeName: {\n        pattern: {\n          like: $pattern\n          ignoreCase: true\n        }\n      }\n    }\n    orderBy: { storeName: ASC }\n    limit: 20\n  )\n  \n  {\n    id\n    storeName\n    storeLocation\n  }\n}\n\n# grab the user's account age and number of price submissions for voter reputation.\n# count each public price pool once, even if the user rejoins.\nquery GetUserStats($userId: String!) @auth(level: USER) {\n  user(\n    key: { id: $userId }\n  ) {\n    id\n    createdAt\n  }\n\n  totalSubmissions: _selectFirst(\n    sql: \"\"\"\n      SELECT COUNT(DISTINCT ps.price_record_id) AS \"count\"\n      FROM price_submission ps\n      JOIN price_record pr\n        ON pr.id = ps.price_record_id\n      WHERE ps.user_id = $1\n        AND pr.is_public = TRUE\n    \"\"\"\n    params: [$userId]\n  )\n}\n\n# grab the user's previous submissions and their unweighted votes for submitter reputation.\n# use limit and offset to grab more history.\nquery GetSubmitterVoteHistory(\n  $userId: String!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: USER) {\n  priceHistory: _select(\n    sql: \"\"\"\n      SELECT\n        ps.price_record_id AS \"priceRecordId\",\n        ps.created_at AS \"submittedAt\",\n        COUNT(*) FILTER (WHERE pv.is_upvote = TRUE) AS \"upvotes\",\n        COUNT(*) FILTER (WHERE pv.is_upvote = FALSE) AS \"downvotes\"\n      FROM price_submission ps\n      JOIN price_record pr\n        ON pr.id = ps.price_record_id\n      LEFT JOIN price_vote pv\n        ON pv.price_record_id = ps.price_record_id\n        AND pv.created_at >= ps.created_at\n        AND (\n          ps.ended_at IS NULL\n          OR pv.created_at < ps.ended_at\n        )\n      WHERE ps.user_id = $1\n        AND pr.is_public = TRUE\n      GROUP BY ps.price_record_id, ps.created_at\n      ORDER BY ps.created_at DESC, ps.price_record_id DESC\n      LIMIT $2 OFFSET $3\n    \"\"\"\n    params: [$userId, $limit, $offset]\n  )\n}\n\n# grab all the votes for a price to calculate the weighted consensus.\n# also grab the voter's account age and when they voted.\nquery GetPriceVotes(\n  $priceRecordId: UUID!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: USER) {\n  votes: _select(\n    sql: \"\"\"\n      SELECT\n        pv.price_record_id AS \"priceRecordId\",\n        pv.user_id AS \"userId\",\n        pv.is_upvote AS \"isUpvote\",\n        pv.created_at AS \"createdAt\",\n        u.created_at AS \"accountCreatedAt\"\n      FROM price_vote pv\n      JOIN \"user\" u\n        ON u.id = pv.user_id\n      JOIN price_record pr\n        ON pr.id = pv.price_record_id\n      WHERE pv.price_record_id = $1\n        AND pr.is_public = TRUE\n      ORDER BY pv.created_at DESC, pv.user_id ASC\n      LIMIT $2 OFFSET $3\n    \"\"\"\n    params: [$priceRecordId, $limit, $offset]\n  )\n}\n\n# grab everyone who submitted a shared public price.\nquery GetPriceSubmitters(\n  $priceRecordId: UUID!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: USER) {\n  submitters: _select(\n    sql: \"\"\"\n      SELECT\n        ps.user_id AS \"userId\",\n        ps.created_at AS \"submittedAt\"\n      FROM price_submission ps\n      JOIN price_record pr\n        ON pr.id = ps.price_record_id\n      WHERE ps.price_record_id = $1\n        AND pr.is_public = TRUE\n        AND ps.ended_at IS NULL\n      ORDER BY ps.created_at ASC, ps.user_id ASC\n      LIMIT $2 OFFSET $3\n    \"\"\"\n    params: [$priceRecordId, $limit, $offset]\n  )\n}\n\n# grab the price information needed to calculate its final confidence.\nquery GetPriceConfidenceData($priceRecordId: UUID!) @auth(level: USER) {\n  priceRecords: _select(\n    sql: \"\"\"\n      SELECT\n        pr.id,\n        pr.price,\n        pr.date_recorded AS \"dateRecorded\",\n        pr.is_public AS \"isPublic\",\n        jsonb_build_object(\n          'id', i.id,\n          'itemName', i.item_name\n        ) AS \"item\",\n        jsonb_build_object(\n          'id', s.id,\n          'storeName', s.store_name\n        ) AS \"store\"\n      FROM price_record pr\n      JOIN item i ON i.id = pr.item_id\n      JOIN store s ON s.id = pr.store_id\n      WHERE pr.id = $1::uuid\n        AND pr.is_public = TRUE\n        AND EXISTS (\n          SELECT 1\n          FROM price_submission ps\n          WHERE ps.price_record_id = pr.id\n            AND ps.ended_at IS NULL\n        )\n      LIMIT 1\n    \"\"\"\n    params: [$priceRecordId]\n  )\n}\n\n# grab the price history of an item at a specific store.\n# only show prices that are public.\nquery GetPriceHistory(\n  $itemId: UUID!\n  $storeId: UUID!\n  $limit: Int!\n  $offset: Int!\n) @auth(level: USER) {\n  priceRecords(\n    where: {\n      itemId: { eq: $itemId }\n      storeId: { eq: $storeId }\n      isPublic: { eq: true }\n    }\n    orderBy: [\n      { dateRecorded: DESC }\n      { id: DESC }\n    ]\n    limit: $limit\n    offset: $offset\n  )\n\n  {\n    id\n    price\n    dateRecorded\n\n    item {\n      id\n      itemName\n      brand\n      unitSize\n    }\n\n    store {\n      id\n      storeName\n      storeLocation\n    }\n  }\n}\n\n# grab all the prices submitted by a user.\n# let them see their previous submissions including private ones.\nquery GetUserSubmissions(\n  $limit: Int!\n  $offset: Int!\n) @auth(level: USER) {\n  submissions: _select(\n    sql: \"\"\"\n      SELECT\n        pr.id AS \"priceRecordId\",\n        pr.price,\n        pr.date_recorded AS \"dateRecorded\",\n        pr.is_public AS \"isPublic\",\n        ps.created_at AS \"submittedAt\",\n        ps.ended_at AS \"endedAt\",\n        i.id AS \"itemId\",\n        i.item_name AS \"itemName\",\n        s.id AS \"storeId\",\n        s.store_name AS \"storeName\",\n        s.store_location AS \"storeLocation\"\n      FROM price_submission ps\n      JOIN price_record pr\n        ON pr.id = ps.price_record_id\n      JOIN item i\n        ON i.id = pr.item_id\n      JOIN store s\n        ON s.id = pr.store_id\n      WHERE ps.user_id = $1\n      ORDER BY ps.created_at DESC, pr.id DESC\n      LIMIT $2 OFFSET $3\n    \"\"\"\n    params: [\n      {_expr: \"auth.uid\"}\n      $limit\n      $offset\n    ]\n  )\n}\n\n","extensions":{"impersonate":{"authClaims":{"uid":"test-a","token":{"email":"test-a@example.com","email_verified":true}},"includeDebugDetails":true}}}
