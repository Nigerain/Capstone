# Copy this file to .env and fill in your own values. Never commit .env.
# After changing anything here, restart Expo with a cleared cache:
#   npx expo start -c

# --- Backend ---
# Where the FastAPI backend runs. On a physical phone, use your laptop's
# Wi-Fi IP address (for example http://192.168.1.20:8000), not localhost:
# on the phone, localhost means the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# --- Mock switches ---
# true (or left out) = fake data, no backend needed. false = the real backend.
# Search, product detail and sign in/up (false = Firebase Auth):
EXPO_PUBLIC_USE_MOCK_DATA=true
# Price tag scanning (OCR), separate so it can stay mocked while the scan
# endpoint is being built. In mock mode, each scan returns the next of 6
# outcomes (good read, missing name/size, unclear price, unreadable photo,
# no connection, daily limit) so every screen can be tested.
EXPO_PUBLIC_USE_MOCK_OCR=true
# Submitting a price, separate because POST /api/v1/prices can't take a
# free-text item yet. In mock mode every submit succeeds, unless the item
# name is TEST 401, TEST 422, TEST 429, TEST 500 or TEST OFFLINE, which
# show that error message instead.
EXPO_PUBLIC_USE_MOCK_SUBMIT=true
# Voting on prices (Compare Prices > tap a store), separate because the
# backend's vote routes aren't written yet. In mock mode votes always save,
# and prices posted by "Ada" count as your own, to see the "Your price" sheet.
EXPO_PUBLIC_USE_MOCK_VOTES=true

# --- Firebase Auth (sign up / log in, when EXPO_PUBLIC_USE_MOCK_DATA=false) ---
# From Firebase Console > Project settings > Your apps > the web app.
# These aren't secrets: they only say which Firebase project to use.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=grocerypricepal.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=grocerypricepal
# Optional for sign-in:
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Dev token (TEMPORARY, optional) ---
# Only needed to test real scanning while search and sign-in stay mocked
# (EXPO_PUBLIC_USE_MOCK_DATA=true, EXPO_PUBLIC_USE_MOCK_OCR=false). With
# EXPO_PUBLIC_USE_MOCK_DATA=false, log in in the app instead.
# `npm run dev-token` fills this in from the three values below.
# Tokens expire after about an hour.
EXPO_PUBLIC_DEV_ID_TOKEN=
FIREBASE_WEB_API_KEY=
TEST_EMAIL=
TEST_PASSWORD=
