# Copy this file to .env and fill in your own values. Never commit .env.
# After changing anything here, restart Expo with a cleared cache:
#   npx expo start -c

# --- Backend ---
# Where the FastAPI backend runs. On a physical phone, use your laptop's
# Wi-Fi IP address (for example http://192.168.1.20:8000), not localhost:
# on the phone, localhost means the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# --- Mock switches ---
# true (or left out) = fake data, no backend needed. false = the real backend.
# Search, product detail and sign in/up:
EXPO_PUBLIC_USE_MOCK_DATA=true
# Price tag scanning (OCR), separate so it can stay mocked while the scan
# endpoint is being built. In mock mode, each scan returns the next of 6
# outcomes (good read, missing name/size, unclear price, unreadable photo,
# no connection, daily limit) so every screen can be tested.
EXPO_PUBLIC_USE_MOCK_OCR=true

# --- Signed-in requests (temporary, until Firebase Auth is connected) ---
# A test account's Firebase ID token. `npm run dev-token` fills this in from
# the three values below. Tokens expire after about an hour.
EXPO_PUBLIC_DEV_ID_TOKEN=
FIREBASE_WEB_API_KEY=
TEST_EMAIL=
TEST_PASSWORD=
