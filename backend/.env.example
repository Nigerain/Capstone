## Server-only Google Vision credentials. Never use an EXPO_PUBLIC variable for this.
## Copy to backend/.env and point to your existing local key file.
# GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/service-account.json"

STORE_LOCATION_LOOKUP_PROVIDER=nominatim
STORE_LOCATION_LOOKUP_BASE_URL=https://nominatim.openstreetmap.org
# Set a real application contact before enabling address lookups.
STORE_LOCATION_LOOKUP_USER_AGENT=
# The in-memory cache supports one backend process and clears on restart.
STORE_LOCATION_LOOKUP_TIMEOUT=10
