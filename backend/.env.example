STORE_LOCATION_LOOKUP_PROVIDER=nominatim
STORE_LOCATION_LOOKUP_BASE_URL=https://nominatim.openstreetmap.org
# Set a real application contact before enabling address lookups.
STORE_LOCATION_LOOKUP_USER_AGENT=
# Absolute path on persistent storage shared by all workers on one host.
STORE_LOCATION_LOOKUP_CACHE_PATH=
STORE_LOCATION_LOOKUP_TIMEOUT=10
